#include <vector>
#include <algorithm>

class Solution {
public:
    std::vector<std::vector<int>> 4Sum(std::vector<int>& nums, int target) {
        std::vector<std::vector<int>> quadruplets;
        int n = nums.size();
        if (n < 4) return quadruplets;
        
        // Sort the array to handle duplicates and enable two-pointer approach
        std::sort(nums.begin(), nums.end());
        
        for (int i = 0; i < n - 3; ++i) {
            // Skip duplicate values for the first element
            if (i > 0 && nums[i] == nums[i - 1]) continue;
            
            for (int j = i + 1; j < n - 2; ++j) {
                // Skip duplicate values for the second element
                if (j > i + 1 && nums[j] == nums[j - 1]) continue;
                
                int left = j + 1;
                int right = n - 1;
                
                while (left < right) {
                    // Use long long to avoid integer overflow issues
                    long long current_sum = (long long)nums[i] + nums[j] + nums[left] + nums[right];
                    
                    if (current_sum == target) {
                        quadruplets.push_back({nums[i], nums[j], nums[left], nums[right]});
                        
                        // Skip duplicate values for the third element
                        while (left < right && nums[left] == nums[left + 1]) left++;
                        // Skip duplicate values for the fourth element
                        while (left < right && nums[right] == nums[right - 1]) right--;
                        
                        left++;
                        right--;
                    } else if (current_sum < target) {
                        left++;
                    } else {
                        right--;
                    }
                }
            }
        }
        
        return quadruplets;
    }
};
