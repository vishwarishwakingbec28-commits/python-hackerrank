class Solution:
    def longestCommonPrefix(self, strs: list[str]) -> str:
        if not strs:
            return ""
        
        # Sort alphabetically
        strs.sort()
        
        first = strs[0]
        last = strs[-1]
        i = 0
        
        # Compare only the first and last strings
        while i < len(first) and i < len(last) and first[i] == last[i]:
            i += 1
            
        return first[:i]
